{
  "window.titleBarStyle": "custom",
  "editor.fontFamily": "'FiraCode Nerd Font','Droid Sans Mono', 'monospace', monospace",
  "editor.renderWhitespace": "trailing",
  "files.trimTrailingWhitespace": true,
  "redhat.telemetry.enabled": false,
  "explorer.confirmDelete": false,
  "editor.inlineSuggest.enabled": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "log.error",
        "settings": {
          "foreground": "#af1f1f",
          "fontStyle": "bold",
        },
      },
      {
        "scope": "log.warning",
        "settings": {
          "foreground": "#f4ad42",
        },
      },
      {
        "scope": "log.info",
        "settings": {
          "foreground": "#66D3FA",
        },
      },
      {
        "scope": "log.date",
        "settings": {
          "foreground": "#418ba7",
          "fontStyle": "bold",
        },
      },
      {
        "scope": "log.string",
        "settings": {
          "foreground": "#cfc45c",
        },
      },
      {
        "scope": "keyword.other.dotenv",
        "settings": {
          "foreground": "#FF000000",
        },
      },
    ],
  },
  "todo-tree.general.tags": ["todo", "bug", "fixme", "note"],
  "todo-tree.regex.regexCaseSensitive": false,
  "todo-tree.highlights.defaultHighlight": {
    "foreground": "#F8DE7E",
    "icon": "file-directory",
    "type": "text",
  },
  "todo-tree.highlights.customHighlight": {
    "note": {
      "foreground": "#c4efff",
      "background": "#002c3a",
      "icon": "note",
    },
    "todo": {
      "foreground": "#22c4ff",
      "icon": "comment",
    },
    "fixme": {
      "foreground": "#FFA500",
      "icon": "flame",
    },
    "bug": {
      "foreground": "#E84855",
      "icon": "bug",
    },
  },
  "workbench.editor.showTabs": "none",
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.cursorSurroundingLines": 1,
  "files.associations": {
    "*.csproj": "xml",
    ".env*": "dotenv",
  },
  "markdown-preview-enhanced.previewTheme": "github-light.css",
  "window.dialogStyle": "custom",
  "powershell.promptToUpdatePowerShell": false,
  "csv-edit.disableBorders": true,
  "csv-edit.writeOption_hasHeader": "true",
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.startupEditor": "none",
  "julia.enableCrashReporter": false,
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://models.dev/model-schema.json": true,
    "https://opencode.ai/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/petabridge/Incrementalist/dev/src/Incrementalist.Cmd/Config/incrementalist.schema.json": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true,
  },
  "powershell.debugging.createTemporaryIntegratedConsole": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 2000,
  "workbench.activityBar.location": "top",
  "window.newWindowProfile": "Default",
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "terminal.integrated.commandsToSkipShell": ["language-julia.interrupt"],
  "julia.symbolCacheDownload": true,
  "laravel-pint.enable": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.colorTheme": "One Dark Vivid",
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
  },
  "Devdb.colorTheme": "dark",
  "Devdb.enableCodeLensForTextSelection": false,
  "git.blame.editorDecoration.enabled": false,
  "markdown-preview-enhanced.codeBlockTheme": "default.css",
  "workbench.iconTheme": "vscode-icons",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "*.qrc": "qt-core.qrcEditor"
  },
  "qt-core.additionalQtPaths": [
    {
      "name": "Qt-5.15.19-linux-g++-x86_64_from_PATH",
      "path": "/usr/bin/qmake"
    }
  ],
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
}
