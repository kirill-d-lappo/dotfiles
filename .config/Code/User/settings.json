{
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.fontFamily": "FiraCode Nerd Font Mono",
  "editor.fontWeight": "400",
  "editor.fontLigatures": false,
  "editor.renderWhitespace": "all",
  "editor.tabSize": 2,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "*.DotSettings": "xml"
  },
  "terminal.integrated.fontWeight": "300",
  "terminal.integrated.fontWeightBold": "400",
  "git-graph.repository.commits.fetchAvatars": true,
  "git-graph.repository.commits.initialLoad": 100,
  "powershell.promptToUpdatePowerShell": false,
  "workbench.iconTheme": "vscode-icons",
  "telemetry.telemetryLevel": "error",
  "todo-tree.general.tags": [
    "todo",
    "bug",
    "fixme"
  ],
  "todo-tree.regex.regexCaseSensitive": false,
  "todo-tree.highlights.defaultHighlight": {
    "fontStyle": "italic",
    "foreground": "#F8DE7E",
    "icon": "file-directory",
    "type": "text"
  },
  "todo-tree.highlights.customHighlight": {
    "todo": {
      "foreground": "#66D3FA",
      "icon": "comment"
    },
    "fixme": {
      "foreground": "#FFA500",
      "icon": "flame"
    },
    "bug": {
      "foreground": "#E84855",
      "icon": "bug"
    }
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "log.error",
        "settings": {
          "foreground": "#af1f1f",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "log.warning",
        "settings": {
          "foreground": "#f4ad42"
        }
      },
      {
        "scope": "log.info",
        "settings": {
          "foreground": "#66D3FA"
        }
      },
      {
        "scope": "log.date",
        "settings": {
          "foreground": "#418ba7",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "log.string",
        "settings": {
          "foreground": "#cfc45c"
        }
      }
    ]
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "markdown.styles": [
    "https://use.fontawesome.com/releases/v5.7.1/css/all.css"
  ],
  "workbench.colorTheme": "One Dark Vivid",
  "git.mergeEditor": true,
  "window.commandCenter": true,
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "editor.minimap.size": "fill",
  "editor.minimap.showSlider": "always",
  "terminal.integrated.shellIntegration.enabled": true,
  "git.branchProtection": [
    "main",
    "master",
    "dev",
    "release*"
  ],
  "redhat.telemetry.enabled": false,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[handlebars]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "editor.largeFileOptimizations": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.shellIntegration.decorationsEnabled": "overviewRuler",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "cSpell.userWords": [
    "CONTAINSTABLE",
    "FREETEXT",
    "FREETEXTTABLE",
    "Linq",
    "NOLOCK",
    "nstarts",
    "Unmanaged",
    "денормализировать",
    "коммите",
    "мьютекса",
    "некластеризованного",
    "Некластеризованные",
    "некластеризованный",
    "подзапросов",
    "потокобезопасный",
    "сфокусированности"
  ],
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[sql]": {
    "editor.defaultFormatter": "ms-mssql.mssql"
  },
  "editor.unicodeHighlight.nonBasicASCII": false,
  "[xml]": {
    "editor.defaultFormatter": "DotJoshJohnson.xml"
  },
  "terminal.integrated.defaultProfile.linux": "pwsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "zsh"
    },
    "fish": {
      "path": "fish"
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux"
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell"
    },
    "nu": {
      "path": "nu",
      "icon": "terminal-bash"
    }
  },
  "Lua.diagnostics.libraryFiles": "Enable",
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.python"
  },
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  "explorer.confirmDelete": false,
  "terminal.integrated.commandsToSkipShell": [
    "language-julia.interrupt"
  ],
  "julia.symbolCacheDownload": true,
  "julia.enableTelemetry": false,
  "evenBetterToml.formatter.alignEntries": true,
  "evenBetterToml.formatter.alignComments": true,
  "evenBetterToml.formatter.arrayAutoCollapse": true,
  "evenBetterToml.formatter.allowedBlankLines": 2,
  "evenBetterToml.formatter.arrayTrailingComma": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "csv-edit.readOption_hasHeader": "true",
  "[snippets]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "update.showReleaseNotes": false,
  "chat.agent.enabled": false,
  "workbench.editor.showTabs": "none",
  "mssql.connectionGroups": [
    {
      "name": "ROOT",
      "id": "ROOT"
    }
  ],
  "editor.unicodeHighlight.allowedLocales": {
    "ru": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  }
}